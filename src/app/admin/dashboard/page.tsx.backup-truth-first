function Core({ title, main, sub, tone }: { title: string; main: string; sub: string; tone: "green" | "blue" | "red" | "orange" }) {
  const color = tone === "green" ? "#15803d" : tone === "blue" ? "#2563eb" : tone === "orange" ? "#f97316" : "#dc2626";
  return (
    <div style={{ ...S.core, borderColor: color }}>
      <div style={{ ...S.coreTitle, color }}>{title}</div>
      <div style={S.coreMain}>{main}</div>
      <div style={S.coreSub}>{sub}</div>
    </div>
  );
}


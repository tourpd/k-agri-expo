function TopCard({ rank, title, desc, href, tone }: { rank: string; title: string; desc: string; href: string; tone: "red" | "green" | "orange" }) {
  const color = tone === "red" ? "#dc2626" : tone === "orange" ? "#f97316" : "#15803d";
  return (
    <Link href={href} style={{ ...S.topCard, borderColor: color }}>
      <div style={{ ...S.rank, background: color }}>{rank}</div>
      <div>
        <h3 style={S.topTitle}>{title}</h3>
        <p style={S.topDesc}>{desc}</p>
      </div>
    </Link>
  );
}

function Kpi({ title, value, href }: { title: string; value: number; href: string }) {
  return (
    <Link href={href} style={S.kpi}>
      <div style={S.kpiTitle}>{title}</div>
      <div style={S.kpiValue}>{value.toLocaleString("ko-KR")}</div>

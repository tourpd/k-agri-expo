async function getBrainData() {
  const supabase = createSupabaseAdminClient();

  const [
    assetCountResult,
    ruleCountResult,
    actionCountResult,
    rulesResult,
  ] = await Promise.all([
    supabase.from("knowledge_assets").select("id", { count: "exact", head: true }),
    supabase.from("knowledge_rules").select("id", { count: "exact", head: true }),
    supabase
      .from("knowledge_rules")
      .select("id", { count: "exact", head: true })
      .not("action_instruction", "is", null),
    supabase
      .from("knowledge_rules")
      .select("id,crop,month,growth_stage,symptom,cause,countermeasure,action_instruction,status")
      .eq("crop", "고추")
      .order("month", { ascending: true })
      .limit(30),
  ]);

  const rules = rulesResult.data && rulesResult.data.length > 0
    ? rulesResult.data
    : fallbackRules;

  return {
    assetCount: assetCountResult.count ?? 0,
    ruleCount: ruleCountResult.count ?? 0,
    actionCount: actionCountResult.count ?? 0,
    rules,
    usingFallback: !rulesResult.data || rulesResult.data.length === 0,
  };
}


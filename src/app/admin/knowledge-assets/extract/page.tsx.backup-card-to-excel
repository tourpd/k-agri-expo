"use client";

import Link from "next/link";
import { useState } from "react";

type Rule = {
  crop: string;
  month: string;
  growth_stage: string;
  symptom: string;
  cause: string;
  countermeasure: string;
  action_instruction: string;
  confidence_score?: number;
  source_reference?: string;
};

export default function KnowledgeExtractPage() {
  const [title, setTitle] = useState("안이영 고추 생육관리와 병충해방제 PPT");
  const [author, setAuthor] = useState("안이영");
  const [crop, setCrop] = useState("고추");
  const [month, setMonth] = useState("5~10월");
  const [rawContent, setRawContent] = useState("");
  const [rules, setRules] = useState<Rule[]>([]);
  const [loading, setLoading] = useState(false);
  const [msg, setMsg] = useState("");

  async function extractRules() {
    if (!rawContent.trim()) {
      alert("원문을 붙여넣어 주세요.");
      return;
    }

    setLoading(true);
    setMsg("AI가 판단규칙을 추출하고 있습니다...");

    try {
      const res = await fetch("/api/admin/knowledge-assets/extract", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          mode: "extract",
          title,
          author,
          crop,
          month,
          raw_content: rawContent,
        }),
      });

      const json = await res.json();

      if (!res.ok) throw new Error(json.error || "AI 추출 실패");

      setRules(json.rules || []);
      setMsg(`추출 완료: ${json.rules?.length || 0}건`);
    } catch (e: any) {
      setMsg(e.message || "오류 발생");
    } finally {
      setLoading(false);
    }
  }

  async function saveRules() {
    if (rules.length === 0) {
      alert("저장할 판단규칙이 없습니다.");
      return;
    }

    setLoading(true);
    setMsg("DB에 저장 중입니다...");

    try {
      const res = await fetch("/api/admin/knowledge-assets/extract", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          mode: "save",
          title,
          author,
          crop,
          month,
          raw_content: rawContent,
          rules,
        }),
      });

      const json = await res.json();

      if (!res.ok) throw new Error(json.error || "저장 실패");

      setMsg(`저장 완료: 원천자료 1건, 판단규칙 ${json.savedRules}건`);
    } catch (e: any) {
      setMsg(e.message || "오류 발생");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main style={S.page}>
      <div style={S.wrap}>
        <header style={S.header}>
          <div>
            <Link href="/admin/knowledge-assets" style={S.back}>← 농업 AI 두뇌센터</Link>
            <div style={S.eyebrow}>K-AGRI AI EXTRACTOR</div>
            <h1 style={S.title}>AI 판단규칙 추출기</h1>
            <p style={S.sub}>
              안이영 자료 원문을 넣으면 작물·월·생육단계·증상·원인·대책·행동지시로 해체합니다.
            </p>
          </div>
          <div style={S.btns}>
            <Link href="/admin/knowledge-assets" style={S.darkBtn}>운영표 보기</Link>
            <Link href="/admin/knowledge-assets/rules" style={S.greenBtn}>판단규칙 DB</Link>
          </div>
        </header>

        <section style={S.grid}>
          <div style={S.left}>
            <div style={S.panel}>
              <h2>1. 자료 정보</h2>

              <label style={S.label}>자료 제목</label>
              <input style={S.input} value={title} onChange={(e) => setTitle(e.target.value)} />

              <div style={S.two}>
                <div>
                  <label style={S.label}>저자 / 출처</label>
                  <input style={S.input} value={author} onChange={(e) => setAuthor(e.target.value)} />
                </div>
                <div>
                  <label style={S.label}>작물</label>
                  <input style={S.input} value={crop} onChange={(e) => setCrop(e.target.value)} />
                </div>
              </div>

              <label style={S.label}>월 / 시기</label>
              <input style={S.input} value={month} onChange={(e) => setMonth(e.target.value)} />
            </div>

            <div style={S.panel}>
              <h2>2. 원문 붙여넣기</h2>
              <p style={S.help}>
                PPT, PDF, 강의자료, 촬영 메모에서 핵심 내용을 그대로 붙여넣으세요.
              </p>
              <textarea
                style={S.textarea}
                value={rawContent}
                onChange={(e) => setRawContent(e.target.value)}
                placeholder="예: 6월 고추는 개화기와 1차 비대기에 들어간다. 이 시기에는 총채벌레, 담배나방, 칼슘결핍, 탄저병 예방이 중요하다..."
              />
              <div style={S.btns}>
                <button style={S.greenButton} onClick={extractRules} disabled={loading}>
                  {loading ? "처리 중..." : "AI 판단규칙 추출"}
                </button>
                <button style={S.darkButton} onClick={saveRules} disabled={loading || rules.length === 0}>
                  DB 저장
                </button>
              </div>
              {msg ? <p style={S.msg}>{msg}</p> : null}
            </div>
          </div>

          <div style={S.right}>
            <div style={S.panel}>
              <h2>3. 추출 결과 미리보기</h2>
              <p style={S.help}>
                저장 전 내용을 확인하세요. 지금은 추출 결과를 그대로 저장합니다.
              </p>

              <div style={S.tableWrap}>
                <table style={S.table}>
                  <thead>
                    <tr>
                      <th style={S.th}>월</th>
                      <th style={S.th}>생육단계</th>
                      <th style={S.th}>증상</th>
                      <th style={S.th}>원인</th>
                      <th style={S.th}>대책</th>
                      <th style={S.thWide}>행동지시</th>
                    </tr>
                  </thead>
                  <tbody>
                    {rules.length === 0 ? (
                      <tr>
                        <td style={S.empty} colSpan={6}>아직 추출된 판단규칙이 없습니다.</td>
                      </tr>
                    ) : (
                      rules.map((r, i) => (
                        <tr key={i}>
                          <td style={S.td}>{r.month}</td>
                          <td style={S.td}>{r.growth_stage}</td>
                          <td style={S.td}>{r.symptom}</td>
                          <td style={S.td}>{r.cause}</td>
                          <td style={S.tdStrong}>{r.countermeasure}</td>
                          <td style={S.tdAction}>{r.action_instruction}</td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>
  );
}

const S: Record<string, React.CSSProperties> = {
  page: { minHeight: "100vh", background: "#eef4f2", color: "#0f172a", padding: 24 },
  wrap: { maxWidth: 1700, margin: "0 auto" },
  header: { display: "flex", justifyContent: "space-between", gap: 20, marginBottom: 20, flexWrap: "wrap" },
  back: { color: "#15803d", textDecoration: "none", fontWeight: 950 },
  eyebrow: { marginTop: 14, color: "#15803d", fontWeight: 950, letterSpacing: ".08em" },
  title: { margin: "8px 0 0", fontSize: 48, lineHeight: 1, fontWeight: 950, letterSpacing: "-.06em" },
  sub: { margin: "12px 0 0", color: "#475569", fontSize: 18, lineHeight: 1.55, fontWeight: 850 },
  grid: { display: "grid", gridTemplateColumns: "520px minmax(0,1fr)", gap: 16 },
  left: { display: "grid", gap: 16 },
  right: { minWidth: 0 },
  panel: { background: "#fff", border: "1px solid #dbe3ea", borderRadius: 22, padding: 20 },
  label: { display: "block", marginTop: 14, marginBottom: 8, fontWeight: 950, color: "#334155" },
  input: { width: "100%", border: "1px solid #cbd5e1", borderRadius: 12, padding: 14, fontSize: 16, fontWeight: 800 },
  textarea: { width: "100%", minHeight: 420, border: "1px solid #cbd5e1", borderRadius: 14, padding: 14, fontSize: 16, fontWeight: 800, lineHeight: 1.6 },
  two: { display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 },
  help: { color: "#64748b", fontWeight: 800, lineHeight: 1.5 },
  btns: { display: "flex", gap: 10, alignItems: "center", flexWrap: "wrap" },
  greenBtn: { background: "#15803d", color: "#fff", padding: "12px 16px", borderRadius: 12, textDecoration: "none", fontWeight: 950 },
  darkBtn: { background: "#0f172a", color: "#fff", padding: "12px 16px", borderRadius: 12, textDecoration: "none", fontWeight: 950 },
  greenButton: { background: "#15803d", color: "#fff", border: 0, padding: "14px 18px", borderRadius: 12, fontWeight: 950, cursor: "pointer" },
  darkButton: { background: "#0f172a", color: "#fff", border: 0, padding: "14px 18px", borderRadius: 12, fontWeight: 950, cursor: "pointer" },
  msg: { background: "#ecfdf5", color: "#15803d", borderRadius: 12, padding: 12, fontWeight: 950 },
  tableWrap: { overflowX: "auto", border: "1px solid #e5e7eb", borderRadius: 16 },
  table: { width: "max-content", minWidth: 1200, borderCollapse: "separate", borderSpacing: 0 },
  th: { background: "#f1f5f9", padding: 12, textAlign: "left", fontWeight: 950, whiteSpace: "nowrap", borderBottom: "1px solid #e5e7eb", minWidth: 130 },
  thWide: { background: "#f1f5f9", padding: 12, textAlign: "left", fontWeight: 950, whiteSpace: "nowrap", borderBottom: "1px solid #e5e7eb", minWidth: 360 },
  td: { padding: 12, borderBottom: "1px solid #edf2f7", fontWeight: 800, verticalAlign: "top", lineHeight: 1.45, maxWidth: 220 },
  tdStrong: { padding: 12, borderBottom: "1px solid #edf2f7", fontWeight: 950, color: "#15803d", verticalAlign: "top", lineHeight: 1.45, maxWidth: 260 },
  tdAction: { padding: 12, borderBottom: "1px solid #edf2f7", fontWeight: 950, color: "#dc2626", verticalAlign: "top", lineHeight: 1.45, minWidth: 360, maxWidth: 460 },
  empty: { padding: 40, textAlign: "center", color: "#64748b", fontWeight: 950 },
};

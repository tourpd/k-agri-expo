"use client";

import Link from "next/link";
import { useState } from "react";

type Rule = {
  crop: string;
  month: string;
  growth_stage: string;
  symptom: string;
  cause: string;
  countermeasure: string;
  action_instruction: string;
  confidence_score?: number;
  source_reference?: string;
};

export default function KnowledgeExtractPage() {
  const [title, setTitle] = useState("안이영 고추 생육관리와 병충해방제 PPT");
  const [author, setAuthor] = useState("안이영");
  const [crop, setCrop] = useState("고추");
  const [month, setMonth] = useState("5~10월");
  const [rawContent, setRawContent] = useState("");
  const [fileName, setFileName] = useState("");
  const [fileQueue, setFileQueue] = useState<{ name: string; status: string; text: string; rules: Rule[] }[]>([]);
  const [rules, setRules] = useState<Rule[]>([]);
  const [loading, setLoading] = useState(false);
  const [msg, setMsg] = useState("");

  async function uploadPpt(file: File) {
    setLoading(true);
    setMsg("파일에서 텍스트를 추출하고 있습니다...");
    setFileName(file.name);

    try {
      const fd = new FormData();
      fd.append("file", file);

      const res = await fetch("/api/admin/knowledge-assets/upload-ppt", {
        method: "POST",
        body: fd,
      });

      const json = await res.json();

      if (!res.ok) throw new Error(json.error || "파일 추출 실패");

      setRawContent(json.text || "");
      setMsg(`파일 텍스트 추출 완료: ${json.slideCount || 0}장`);
    } catch (e: any) {
      setMsg(e.message || "오류 발생");
    } finally {
      setLoading(false);
    }
  }

  async function uploadMany(files: FileList | null) {
    if (!files || files.length === 0) return;

    setLoading(true);
    setMsg(`${files.length}개 파일 일괄 추출을 시작합니다...`);

    const queue: { name: string; status: string; text: string; rules: Rule[] }[] = [];

    for (const file of Array.from(files)) {
      const item = { name: file.name, status: "추출 중", text: "", rules: [] as Rule[] };
      queue.push(item);
      setFileQueue([...queue]);

      try {
        const fd = new FormData();
        fd.append("file", file);

        const res = await fetch("/api/admin/knowledge-assets/upload-ppt", {
          method: "POST",
          body: fd,
        });

        const json = await res.json();

        if (!res.ok) throw new Error(json.error || "파일 추출 실패");

        item.status = "텍스트 추출 완료";
        item.text = json.text || "";
      } catch (e: any) {
        item.status = `실패: ${e.message || "오류"}`;
      }

      setFileQueue([...queue]);
    }

    const firstOk = queue.find((q) => q.text);
    if (firstOk) {
      setFileName(firstOk.name);
      setRawContent(firstOk.text);
    }

    setMsg(`일괄 텍스트 추출 완료: ${queue.filter((q) => q.text).length}/${queue.length}개 성공`);
    setLoading(false);
  }

  async function extractManyRules() {
    const targets = fileQueue.filter((f) => f.text);

    if (targets.length === 0) {
      alert("AI 추출할 파일이 없습니다.");
      return;
    }

    setLoading(true);
    setMsg(`${targets.length}개 자료에서 AI 판단규칙을 추출합니다...`);

    const next = [...fileQueue];

    for (const item of next) {
      if (!item.text) continue;

      item.status = "AI 추출 중";
      setFileQueue([...next]);

      try {
        const res = await fetch("/api/admin/knowledge-assets/extract", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            mode: "extract",
            title: item.name,
            author,
            crop,
            month,
            raw_content: item.text,
          }),
        });

        const json = await res.json();

        if (!res.ok) throw new Error(json.error || "AI 추출 실패");

        item.rules = json.rules || [];
        item.status = `AI 추출 완료 ${item.rules.length}건`;
      } catch (e: any) {
        item.status = `AI 실패: ${e.message || "오류"}`;
      }

      setFileQueue([...next]);
    }

    const allRules = next.flatMap((f) => f.rules);
    setRules(allRules);
    setMsg(`일괄 AI 추출 완료: 판단규칙 ${allRules.length}건`);
    setLoading(false);
  }

  async function saveManyRules() {
    const targets = fileQueue.filter((f) => f.rules.length > 0);

    if (targets.length === 0) {
      alert("저장할 판단규칙이 없습니다.");
      return;
    }

    setLoading(true);
    setMsg(`${targets.length}개 자료를 DB에 일괄 저장합니다...`);

    let savedAssets = 0;
    let savedRules = 0;

    for (const item of targets) {
      item.status = "DB 저장 중";
      setFileQueue([...fileQueue]);

      try {
        const res = await fetch("/api/admin/knowledge-assets/extract", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            mode: "save",
            title: item.name,
            author,
            crop,
            month,
            raw_content: item.text,
            rules: item.rules,
          }),
        });

        const json = await res.json();

        if (!res.ok) throw new Error(json.error || "저장 실패");

        savedAssets += 1;
        savedRules += Number(json.savedRules || 0);
        item.status = `DB 저장 완료 ${json.savedRules || 0}건`;
      } catch (e: any) {
        item.status = `저장 실패: ${e.message || "오류"}`;
      }

      setFileQueue([...fileQueue]);
    }

    setMsg(`일괄 저장 완료: 자료 ${savedAssets}개, 판단규칙 ${savedRules}건`);
    setLoading(false);
  }

  async function extractRules() {
    if (!rawContent.trim()) {
      alert("PPT를 업로드하거나 원문을 붙여넣어 주세요.");
      return;
    }

    setLoading(true);
    setMsg("AI가 판단규칙을 추출하고 있습니다...");

    try {
      const res = await fetch("/api/admin/knowledge-assets/extract", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          mode: "extract",
          title,
          author,
          crop,
          month,
          raw_content: rawContent,
        }),
      });

      const json = await res.json();

      if (!res.ok) throw new Error(json.error || "AI 추출 실패");

      setRules(json.rules || []);
      setMsg(`추출 완료: ${json.rules?.length || 0}건`);
    } catch (e: any) {
      setMsg(e.message || "오류 발생");
    } finally {
      setLoading(false);
    }
  }

  async function saveRules() {
    if (rules.length === 0) {
      alert("저장할 판단규칙이 없습니다.");
      return;
    }

    setLoading(true);
    setMsg("DB에 저장 중입니다...");

    try {
      const res = await fetch("/api/admin/knowledge-assets/extract", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          mode: "save",
          title,
          author,
          crop,
          month,
          raw_content: rawContent,
          rules,
        }),
      });

      const json = await res.json();

      if (!res.ok) throw new Error(json.error || "저장 실패");

      setMsg(`저장 완료: 원천자료 1건, 판단규칙 ${json.savedRules}건`);
    } catch (e: any) {
      setMsg(e.message || "오류 발생");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main style={S.page}>
      <div style={S.wrap}>
        <header style={S.header}>
          <div>
            <Link href="/admin/knowledge-assets" style={S.back}>← 농업 AI 두뇌센터</Link>
            <div style={S.eyebrow}>K-AGRI AI EXTRACTOR</div>
            <h1 style={S.title}>AI 판단규칙 추출기</h1>
            <p style={S.sub}>
              자료 원문을 넣고 AI가 뽑은 판단규칙을 엑셀형 표에서 검수한 뒤 DB에 저장합니다.
            </p>
          </div>
          <div style={S.btns}>
            <Link href="/admin/knowledge-assets" style={S.darkBtn}>운영표 보기</Link>
            <Link href="/admin/knowledge-assets/rules" style={S.greenBtn}>판단규칙 DB</Link>
          </div>
        </header>

        <section style={S.topPanel}>
          <div style={S.field}>
            <label style={S.label}>자료 제목</label>
            <input style={S.input} value={title} onChange={(e) => setTitle(e.target.value)} />
          </div>

          <div style={S.fieldSmall}>
            <label style={S.label}>저자 / 출처</label>
            <input style={S.input} value={author} onChange={(e) => setAuthor(e.target.value)} />
          </div>

          <div style={S.fieldTiny}>
            <label style={S.label}>작물</label>
            <input style={S.input} value={crop} onChange={(e) => setCrop(e.target.value)} />
          </div>

          <div style={S.fieldTiny}>
            <label style={S.label}>월 / 시기</label>
            <input style={S.input} value={month} onChange={(e) => setMonth(e.target.value)} />
          </div>

          <div style={S.actionBox}>
            <button style={S.greenButton} onClick={extractRules} disabled={loading}>
              {loading ? "처리 중..." : "AI 추출"}
            </button>
            <button style={S.darkButton} onClick={saveRules} disabled={loading || rules.length === 0}>
              DB 저장
            </button>
          </div>
        </section>

        {msg ? <section style={S.msg}>{msg}</section> : null}

        <section style={S.editorGrid}>
          <div style={S.rawBox}>
            <div style={S.panelHead}>
              <h2>PPT 업로드</h2>
              <p>PPT, PPTX, PDF, Word, HWP, HWPX 파일을 올리면 텍스트를 자동 추출합니다.</p>

              <label style={S.uploadBox}>
                <input
                  type="file"
                  multiple
                  accept=".ppt,.pptx,.pdf,.doc,.docx,.hwp,.hwpx"
                  style={{ display: "none" }}
                  onChange={(e) => uploadMany(e.target.files)}
                />
                자료 파일 일괄 선택
              </label>

              {fileName ? <p style={S.fileName}>현재 미리보기: {fileName}</p> : null}

              {fileQueue.length > 0 ? (
                <div style={S.queueBox}>
                  <div style={S.queueHead}>
                    <b>일괄 처리 목록 {fileQueue.length}개</b>
                    <div style={S.btns}>
                      <button style={S.greenButton} onClick={extractManyRules} disabled={loading}>
                        일괄 AI 추출
                      </button>
                      <button style={S.darkButton} onClick={saveManyRules} disabled={loading}>
                        일괄 DB 저장
                      </button>
                    </div>
                  </div>

                  <div style={S.queueTableWrap}>
                    <table style={S.queueTable}>
                      <thead>
                        <tr>
                          <th style={S.qth}>파일명</th>
                          <th style={S.qth}>상태</th>
                          <th style={S.qth}>텍스트</th>
                          <th style={S.qth}>규칙</th>
                          <th style={S.qth}>보기</th>
                        </tr>
                      </thead>
                      <tbody>
                        {fileQueue.map((f, i) => (
                          <tr key={`${f.name}-${i}`}>
                            <td style={S.qtd}>{f.name}</td>
                            <td style={S.qtdStrong}>{f.status}</td>
                            <td style={S.qtd}>{f.text ? `${f.text.length.toLocaleString()}자` : "-"}</td>
                            <td style={S.qtd}>{f.rules.length}건</td>
                            <td style={S.qtd}>
                              <button
                                style={S.smallBtn}
                                onClick={() => {
                                  setFileName(f.name);
                                  setRawContent(f.text);
                                  setRules(f.rules);
                                }}
                              >
                                열기
                              </button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ) : null}

              <p style={S.helpText}>※ 지원: ppt, pptx, pdf, doc, docx, hwp, hwpx. 단, 스캔 PDF는 OCR 단계가 별도로 필요합니다.</p>
            </div>

            <div style={S.panelHead}>
              <h2>추출된 원문</h2>
              <p>PPT에서 뽑힌 텍스트입니다. 필요하면 직접 수정할 수 있습니다.</p>
            </div>
            <textarea
              style={S.textarea}
              value={rawContent}
              onChange={(e) => setRawContent(e.target.value)}
              placeholder="예: 6월 고추는 개화기와 1차 비대기에 들어간다. 이 시기에는 총채벌레, 담배나방, 칼슘결핍, 탄저병 예방이 중요하다..."
            />
          </div>

          <div style={S.resultBox}>
            <div style={S.panelHeadRow}>
              <div>
                <h2>추출 결과 검수표</h2>
                <p>AI가 뽑은 규칙을 한 줄 한 건으로 확인합니다.</p>
              </div>
              <b style={S.countBadge}>{rules.length}건</b>
            </div>

            <div style={S.tableWrap}>
              <table style={S.table}>
                <thead>
                  <tr>
                    <th style={S.thCheck}>선택</th>
                    <th style={S.th}>작물</th>
                    <th style={S.th}>월</th>
                    <th style={S.th}>생육단계</th>
                    <th style={S.th}>증상</th>
                    <th style={S.th}>원인</th>
                    <th style={S.th}>대책</th>
                    <th style={S.thWide}>행동지시</th>
                    <th style={S.th}>신뢰도</th>
                    <th style={S.th}>출처</th>
                  </tr>
                </thead>
                <tbody>
                  {rules.length === 0 ? (
                    <tr>
                      <td style={S.empty} colSpan={10}>
                        아직 추출된 판단규칙이 없습니다. 원문을 붙여넣고 AI 추출을 누르세요.
                      </td>
                    </tr>
                  ) : (
                    rules.map((r, i) => (
                      <tr key={i}>
                        <td style={S.tdCheck}><input type="checkbox" defaultChecked /></td>
                        <td style={S.tdStrong}>{r.crop}</td>
                        <td style={S.td}>{r.month}</td>
                        <td style={S.td}>{r.growth_stage}</td>
                        <td style={S.td}>{r.symptom}</td>
                        <td style={S.td}>{r.cause}</td>
                        <td style={S.tdStrong}>{r.countermeasure}</td>
                        <td style={S.tdAction}>{r.action_instruction}</td>
                        <td style={S.td}>{r.confidence_score ?? "-"}</td>
                        <td style={S.td}>{r.source_reference || "-"}</td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section style={S.bottomBar}>
          <div>
            <b>운영 기준</b>
            <p>이 화면은 자료 1개에서 규칙 10~100건을 뽑아 검수하는 작업대입니다.</p>
          </div>
          <div style={S.btns}>
            <button style={S.greenButton} onClick={extractRules} disabled={loading}>현재 파일 AI 추출</button>
            <button style={S.darkButton} onClick={saveRules} disabled={loading || rules.length === 0}>현재 파일 DB 저장</button>
            <button style={S.greenButton} onClick={extractManyRules} disabled={loading || fileQueue.length === 0}>일괄 AI 추출</button>
            <button style={S.darkButton} onClick={saveManyRules} disabled={loading || fileQueue.length === 0}>일괄 DB 저장</button>
          </div>
        </section>
      </div>
    </main>
  );
}



import Link from "next/link";
import { createSupabaseAdminClient } from "@/lib/supabase/admin";

export const dynamic = "force-dynamic";

function clean(v: unknown) {
  return String(v ?? "").replace(/\s+/g, " ").trim();
}

function topicKey(title: string) {
  const t = clean(title);

  if (t.includes("풋고추") || t.includes("다수확")) return "풋고추 다수확";
  if (t.includes("모자이크") || t.includes("바이러스")) return "고추 바이러스";
  if (t.includes("역병")) return "고추 역병";
  if (t.includes("탄저")) return "고추 탄저병";
  if (t.includes("총채")) return "총채벌레";
  if (t.includes("과다수분") || t.includes("과습")) return "과다수분·과습";
  if (t.includes("토양") || t.includes("미생물")) return "토양 미생물";
  if (t.includes("활착")) return "활착장해";
  if (t.includes("약제") || t.includes("방제")) return "약제 방제";
  if (t.includes("과실") || t.includes("장해")) return "생리장해·과실장해";

  return t.slice(0, 24) || "기타 이슈";
}

function grade(score: number) {
  if (score >= 95) return "S+";
  if (score >= 90) return "S";
  if (score >= 80) return "A";
  if (score >= 70) return "B";
  return "C";
}

function signal(g: string) {
  if (g === "S+" || g === "S") return "🟢";
  if (g === "A") return "🟡";
  if (g === "B") return "🟠";
  return "🔴";
}

function bar(n: number) {
  const v = Math.max(0, Math.min(100, Number(n || 0)));
  const filled = Math.round(v / 10);
  return "█".repeat(filled) + "░".repeat(10 - filled);
}

export default async function BrainPage() {
  const supabase = createSupabaseAdminClient();

  const { data } = await supabase
    .from("writers_room_recommendations")
    .select(`
      id,
      title,
      content_type,
      reason,
      score,
      farmer_score,
      money_score,
      view_score,
      commerce_score,
      urgency_score,
      grade,
      source_page_id,
      source_page_number
    `)
    .order("score", { ascending: false })
    .limit(300);

  const rows = data ?? [];

  const map = new Map<string, any>();

  for (const r of rows) {
    const key = topicKey(r.title);
    const prev = map.get(key);

    const item = {
      topic: key,
      best_id: r.id,
      best_title: r.title,
      score: Number(r.score ?? 0),
      farmer_score: Number(r.farmer_score ?? 0),
      money_score: Number(r.money_score ?? 0),
      view_score: Number(r.view_score ?? 0),
      commerce_score: Number(r.commerce_score ?? 0),
      urgency_score: Number(r.urgency_score ?? 0),
      evidence_count: 1,
      pages: r.source_page_number ? [r.source_page_number] : [],
      reasons: [r.reason].filter(Boolean),
    };

    if (!prev) {
      map.set(key, item);
    } else {
      prev.score = Math.max(prev.score, item.score);
      prev.farmer_score = Math.max(prev.farmer_score, item.farmer_score);
      prev.money_score = Math.max(prev.money_score, item.money_score);
      prev.view_score = Math.max(prev.view_score, item.view_score);
      prev.commerce_score = Math.max(prev.commerce_score, item.commerce_score);
      prev.urgency_score = Math.max(prev.urgency_score, item.urgency_score);
      prev.evidence_count += 1;
      prev.pages = Array.from(new Set([...prev.pages, ...item.pages])).sort((a: number, b: number) => a - b);
      if (item.score > prev.score) {
        prev.best_id = item.best_id;
        prev.best_title = item.best_title;
      }
      prev.reasons = Array.from(new Set([...prev.reasons, ...item.reasons])).slice(0, 3);
    }
  }

  const issues = Array.from(map.values())
    .map((x: any) => {
      const finalScore = Math.round(
        x.farmer_score * 0.25 +
        x.money_score * 0.25 +
        x.view_score * 0.2 +
        x.commerce_score * 0.15 +
        x.urgency_score * 0.15
      );
      return {
        ...x,
        final_score: finalScore,
        final_grade: grade(finalScore),
      };
    })
    .sort((a: any, b: any) => b.final_score - a.final_score)
    .slice(0, 12);

  const top3 = issues.slice(0, 3);

  return (
    <main className="min-h-screen bg-[#f4f6f8] p-5 text-black">
      <section className="mb-6 rounded-3xl bg-black p-7 text-white">
        <p className="text-sm font-black text-green-300">K-AGRI BRAIN</p>
        <h1 className="mt-2 text-4xl font-black">농업 의사결정실</h1>
        <p className="mt-3 text-lg text-gray-300">
          자료를 보여주는 곳이 아니라, 농민 문제를 판단하고 오늘 무엇을 만들지 결정하는 곳입니다.
        </p>

        <div className="mt-6 grid gap-3 md:grid-cols-4">
          <div className="rounded-2xl bg-white/10 p-4">
            <div className="text-xs text-gray-300">원본 추천</div>
            <div className="text-3xl font-black">{rows.length}</div>
          </div>
          <div className="rounded-2xl bg-white/10 p-4">
            <div className="text-xs text-gray-300">압축 이슈</div>
            <div className="text-3xl font-black">{issues.length}</div>
          </div>
          <div className="rounded-2xl bg-white/10 p-4">
            <div className="text-xs text-gray-300">오늘 TOP</div>
            <div className="text-3xl font-black">{top3[0]?.topic ?? "-"}</div>
          </div>
          <div className="rounded-2xl bg-white/10 p-4">
            <div className="text-xs text-gray-300">결정 방식</div>
            <div className="text-3xl font-black">PD 최종</div>
          </div>
        </div>
      </section>

      <section className="mb-6 rounded-3xl border bg-white p-6 shadow-sm">
        <h2 className="mb-5 text-3xl font-black">오늘 먼저 볼 TOP 3</h2>

        <div className="grid gap-5 lg:grid-cols-3">
          {top3.map((x: any, i: number) => (
            <div key={x.topic} className="rounded-3xl border-2 border-black bg-white p-5 shadow-sm">
              <div className="flex items-center justify-between">
                <div className="text-2xl font-black">
                  {i === 0 ? "🥇" : i === 1 ? "🥈" : "🥉"} {x.final_grade}
                </div>
                <div className="rounded-full bg-green-100 px-4 py-2 text-sm font-black text-green-800">
                  {signal(x.final_grade)} 제작 검토
                </div>
              </div>

              <h3 className="mt-4 text-2xl font-black leading-snug">{x.topic}</h3>
              <p className="mt-2 text-sm text-gray-600">{x.best_title}</p>

              <div className="mt-5 space-y-2 text-sm font-bold">
                <div>농민도움 {bar(x.farmer_score)} {x.farmer_score}</div>
                <div>돈연결　 {bar(x.money_score)} {x.money_score}</div>
                <div>조회수　 {bar(x.view_score)} {x.view_score}</div>
                <div>공동구매 {bar(x.commerce_score)} {x.commerce_score}</div>
                <div>시급성　 {bar(x.urgency_score)} {x.urgency_score}</div>
              </div>

              <div className="mt-5 rounded-2xl bg-gray-50 p-4">
                <div className="text-sm font-black">근거</div>
                <div className="mt-1 text-sm">
                  관련 근거 {x.evidence_count}건 · 원본 페이지 {x.pages.slice(0, 6).join(", ")}
                </div>
              </div>

              <Link
                href={`/admin/writers-room/${x.best_id}`}
                className="mt-5 block rounded-2xl bg-black px-5 py-3 text-center font-black text-white"
              >
                근거 보고 결정하기
              </Link>
            </div>
          ))}
        </div>
      </section>

      <section className="mb-6 rounded-3xl border bg-white p-6 shadow-sm">
        <h2 className="mb-5 text-3xl font-black">PD 아이디어 입력</h2>
        <div className="rounded-2xl border-2 border-dashed p-5">
          <p className="mb-3 text-sm font-bold text-gray-500">
            예: 요즘 고추 왜 죽지? / 양파 저장 괜찮을까? / 총채벌레 지금 심각한가?
          </p>
          <div className="flex flex-col gap-3 md:flex-row">
            <input
              className="flex-1 rounded-2xl border p-4 text-lg font-bold"
              placeholder="농민 문제나 PD 아이디어를 입력하세요"
            />
            <button className="rounded-2xl bg-green-700 px-8 py-4 text-lg font-black text-white">
              K-AGRI BRAIN 분석
            </button>
          </div>
          <p className="mt-3 text-sm text-gray-500">
            다음 단계에서 이 입력값으로 안이영·한국농수산TV·농민질문·병해충DB를 함께 검색하게 만듭니다.
          </p>
        </div>
      </section>

      <section className="rounded-3xl border bg-white p-6 shadow-sm">
        <h2 className="mb-5 text-3xl font-black">전체 압축 이슈</h2>

        <div className="overflow-x-auto">
          <table className="w-full min-w-[1100px] border-collapse text-sm">
            <thead className="bg-gray-100">
              <tr>
                <th className="border p-3 text-left">순위</th>
                <th className="border p-3 text-left">등급</th>
                <th className="border p-3 text-left">이슈</th>
                <th className="border p-3 text-left">종합</th>
                <th className="border p-3 text-left">농민도움</th>
                <th className="border p-3 text-left">돈</th>
                <th className="border p-3 text-left">조회수</th>
                <th className="border p-3 text-left">공동구매</th>
                <th className="border p-3 text-left">시급성</th>
                <th className="border p-3 text-left">근거</th>
                <th className="border p-3 text-left">결정</th>
              </tr>
            </thead>
            <tbody>
              {issues.map((x: any, i: number) => (
                <tr key={x.topic} className="hover:bg-yellow-50">
                  <td className="border p-3 font-black">{i + 1}</td>
                  <td className="border p-3 text-lg font-black">{signal(x.final_grade)} {x.final_grade}</td>
                  <td className="border p-3 font-black">{x.topic}</td>
                  <td className="border p-3 font-black">{x.final_score}</td>
                  <td className="border p-3">{x.farmer_score}</td>
                  <td className="border p-3">{x.money_score}</td>
                  <td className="border p-3">{x.view_score}</td>
                  <td className="border p-3">{x.commerce_score}</td>
                  <td className="border p-3">{x.urgency_score}</td>
                  <td className="border p-3">{x.evidence_count}건 / {x.pages.slice(0, 5).join(", ")}</td>
                  <td className="border p-3">
                    <Link
                      href={`/admin/writers-room/${x.best_id}`}
                      className="rounded-lg bg-black px-4 py-2 text-xs font-black text-white"
                    >
                      보기
                    </Link>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  );
}

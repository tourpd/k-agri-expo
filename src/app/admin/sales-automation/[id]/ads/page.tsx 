    status: "draft",

  },

];

export default function ShortsPage({ params }: { params: { id: string } }) {

  const [items, setItems] = useState<ShortsItem[]>(initialShorts);

  const [selectedId, setSelectedId] = useState(items[0].id);

  const [request, setRequest] = useState(

    "더 짧게 / 더 웃기게 / 첫 2초 강하게 / 제품은 마지막에 / 자막 없이 영상 먼저"

  );

  const selected = items.find((item) => item.id === selectedId) || items[0];

  function updateItem(id: string, patch: Partial<ShortsItem>) {

    setItems((prev) =>

      prev.map((item) => (item.id === id ? { ...item, ...patch } : item))

    );

  }

  function addShorts() {

    const id = `SHORTS_${Date.now()}`;

    const next: ShortsItem = {

      id,

      title: "새 쇼츠",

      concept: "새 컨셉",

      hook: "첫 2초 후킹 문구",

      scene1: "0~3초 장면",

      scene2: "3~10초 장면",

      scene3: "10~17초 장면",

      cta: "17~20초 CTA",

      veoPrompt:

        "9:16 vertical, 8K ultra realistic, Korean agriculture commercial shorts, cinematic, no subtitles, no watermark",

      status: "draft",

    };

    setItems((prev) => [...prev, next]);

    setSelectedId(id);

  }

  function removeShorts(id: string) {

    setItems((prev) => prev.filter((item) => item.id !== id));

    setSelectedId(items[0]?.id || "");

  }

  return (

    <main className="min-h-screen bg-[#f4f7f2] p-5 text-stone-950">

      <div className="mx-auto max-w-[1800px]">

        <Link

          href={`/admin/sales-automation/${params.id}/workspace`}

          className="text-xl font-black text-green-700"

        >

          ← 편집 작업실

        </Link>

        <div className="mt-4 flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">

          <div>

            <h1 className="text-5xl font-black">쇼츠 제작센터</h1>

            <p className="mt-3 text-xl font-bold text-stone-600">

              0~3초 후킹, 장면 구성, CTA, Veo 프롬프트를 편집합니다.

            </p>

          </div>

          <div className="flex flex-wrap gap-3">

            <Link

              href={`/admin/sales-automation/${params.id}/ads`}

              className="rounded-2xl bg-red-700 px-6 py-4 text-xl font-black text-white"

            >

              광고센터

            </Link>

            <Link

              href={`/admin/sales-automation/${params.id}/videos`}

              className="rounded-2xl bg-purple-700 px-6 py-4 text-xl font-black text-white"

            >

              영상센터

            </Link>

          </div>

        </div>

        <section className="mt-8 rounded-3xl bg-white p-6 shadow-xl">

          <h2 className="text-3xl font-black">쇼츠 수정 요청</h2>

          <textarea

            value={request}

            onChange={(e) => setRequest(e.target.value)}

            rows={4}

            className="mt-4 w-full rounded-3xl border border-stone-300 bg-yellow-50 p-5 text-xl font-bold"

            placeholder="예: 더 웃기게 / 첫 2초 강하게 / 농민 말투로 / 제품은 마지막에 / 자막 없이"

          />

          <div className="mt-4 flex flex-wrap gap-3">

            <ActionButton label="선택 쇼츠 재작성" />

            <ActionButton label="후킹만 다시" />

            <ActionButton label="Veo 프롬프트 강화" />

            <ActionButton label="15초 버전" />

            <ActionButton label="30초 버전" />

          </div>

        </section>

        <div className="mt-8 grid gap-6 xl:grid-cols-[420px_1fr_480px]">

          <section className="rounded-3xl bg-white p-5 shadow-xl">

            <div className="flex items-center justify-between">

              <h2 className="text-3xl font-black">쇼츠 목록</h2>

              <button

                onClick={addShorts}

                className="rounded-2xl bg-green-700 px-4 py-3 text-lg font-black text-white"

              >

                + 추가

              </button>

            </div>

            <div className="mt-5 grid gap-3">

              {items.map((item) => (

                <button

                  key={item.id}

                  onClick={() => setSelectedId(item.id)}

                  className={`rounded-2xl border-2 p-4 text-left ${

                    selectedId === item.id

                      ? "border-black bg-stone-100"

                      : "border-stone-200 bg-stone-50"

                  }`}

                >

                  <div className="flex items-center justify-between gap-3">

                    <p className="text-lg font-black">{item.title}</p>

                    <span

                      className={`rounded-full px-3 py-1 text-sm font-black ${

                        item.status === "selected"

                          ? "bg-green-100 text-green-800"

                          : item.status === "rejected"

                            ? "bg-red-100 text-red-800"

                            : "bg-yellow-100 text-yellow-800"

                      }`}

                    >

                      {item.status === "selected"

                        ? "채택"

                        : item.status === "rejected"

                          ? "탈락"

                          : "초안"}

                    </span>

                  </div>

                  <p className="mt-2 text-base font-bold text-stone-600">

                    {item.hook}

                  </p>

                </button>

              ))}

            </div>

          </section>

          <section className="rounded-3xl bg-white p-6 shadow-xl">

            <div className="flex flex-wrap items-center justify-between gap-3">

              <h2 className="text-3xl font-black">쇼츠 편집</h2>

              <div className="flex flex-wrap gap-2">

                <SmallButton

                  label="채택"

                  onClick={() => updateItem(selected.id, { status: "selected" })}

                />

                <SmallButton

                  label="탈락"

                  onClick={() => updateItem(selected.id, { status: "rejected" })}

                />

                <SmallButton label="삭제" onClick={() => removeShorts(selected.id)} />

              </div>

            </div>

            <div className="mt-6 grid gap-5">

              <EditField

                label="제목"

                value={selected.title}

                onChange={(v) => updateItem(selected.id, { title: v })}

              />

              <EditField

                label="컨셉"

                value={selected.concept}

                onChange={(v) => updateItem(selected.id, { concept: v })}

              />

              <EditField

                label="0~3초 후킹"

                value={selected.hook}

                onChange={(v) => updateItem(selected.id, { hook: v })}

              />

              <EditArea

                label="0~3초 장면"

                value={selected.scene1}

                onChange={(v) => updateItem(selected.id, { scene1: v })}

              />

              <EditArea

                label="3~10초 장면"

                value={selected.scene2}

                onChange={(v) => updateItem(selected.id, { scene2: v })}

              />

              <EditArea

                label="10~17초 장면"

                value={selected.scene3}

                onChange={(v) => updateItem(selected.id, { scene3: v })}

              />

              <EditField

                label="17~20초 CTA"

                value={selected.cta}

                onChange={(v) => updateItem(selected.id, { cta: v })}

              />

              <EditArea

                label="Veo 영상 프롬프트"

                value={selected.veoPrompt}

                onChange={(v) => updateItem(selected.id, { veoPrompt: v })}

              />

            </div>

          </section>

          <section className="rounded-3xl bg-white p-5 shadow-xl">

            <h2 className="text-3xl font-black">세로 쇼츠 미리보기</h2>

            <div className="mx-auto mt-5 max-w-[360px] overflow-hidden rounded-[2rem] border-4 border-black bg-black text-white shadow-2xl">

              <div className="bg-yellow-300 p-5 text-black">

                <p className="text-sm font-black">{selected.concept}</p>

                <h3 className="mt-2 text-3xl font-black leading-tight">

                  {selected.hook}

                </h3>

              </div>

              <PreviewScene label="0~3초" text={selected.scene1} />

              <PreviewScene label="3~10초" text={selected.scene2} />

              <PreviewScene label="10~17초" text={selected.scene3} />

              <div className="bg-green-700 p-5 text-center">

                <p className="text-2xl font-black">{selected.cta}</p>

              </div>

            </div>

            <div className="mt-5 grid gap-3">

              <button

                onClick={() => navigator.clipboard.writeText(selected.veoPrompt)}

                className="rounded-2xl bg-purple-700 px-5 py-4 text-lg font-black text-white"

              >

                Veo 프롬프트 복사

              </button>

              <button

                onClick={() =>

                  navigator.clipboard.writeText(

                    `${selected.hook}\n\n${selected.scene1}\n\n${selected.scene2}\n\n${selected.scene3}\n\n${selected.cta}`

                  )

                }

                className="rounded-2xl bg-stone-900 px-5 py-4 text-lg font-black text-white"

              >

                쇼츠 대본 복사

              </button>

            </div>

          </section>

        </div>

      </div>

    </main>

  );

}

function PreviewScene({ label, text }: { label: string; text: string }) {

  return (

    <div className="border-t-4 border-white/20 p-5">

      <p className="text-sm font-black text-yellow-300">{label}</p>

      <p className="mt-2 whitespace-pre-wrap text-lg font-bold leading-relaxed">

        {text}

      </p>

    </div>

  );

}

function EditField({

  label,

  value,

  onChange,

}: {

  label: string;

  value: string;

  onChange: (v: string) => void;

}) {

  return (

    <label className="block">

      <p className="mb-2 text-xl font-black">{label}</p>

      <input

        value={value}

        onChange={(e) => onChange(e.target.value)}

        className="w-full rounded-2xl border border-stone-300 p-4 text-xl font-bold"

      />

    </label>

  );

}

function EditArea({

  label,

  value,

  onChange,

}: {

  label: string;

  value: string;

  onChange: (v: string) => void;

}) {

  return (

    <label className="block">

      <p className="mb-2 text-xl font-black">{label}</p>

      <textarea

        value={value}

        onChange={(e) => onChange(e.target.value)}

        rows={5}

        className="w-full rounded-2xl border border-stone-300 p-4 text-lg font-bold leading-relaxed"

      />

    </label>

  );

}

function ActionButton({ label }: { label: string }) {

  return (

    <button className="rounded-2xl bg-stone-900 px-5 py-4 text-lg font-black text-white">

      {label}

    </button>

  );

}

function SmallButton({

  label,

  onClick,

}: {

  label: string;

  onClick: () => void;

}) {

  return (

    <button

      onClick={onClick}

      className="rounded-xl bg-stone-900 px-4 py-3 text-base font-black text-white"

    >

      {label}

    </button>

  );

}
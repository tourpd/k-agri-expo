import {
  NextRequest,
  NextResponse,
} from "next/server";

import {
  normalizeTranscriptText,
  isLowValueClosing,
  looksLikeQuestion,
} from "@/lib/jopd-studio/transcript-normalizer";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

function extractOutputText(data: any) {
  if (typeof data?.output_text === "string") {
    return data.output_text;
  }

  const pieces: string[] = [];

  for (const item of data?.output || []) {
    for (const content of item?.content || []) {
      if (typeof content?.text === "string") {
        pieces.push(content.text);
      }
    }
  }

  return pieces.join("\n");
}

function parseJson(text: string) {
  const cleaned = text
    .replace(/^```json/i, "")
    .replace(/^```/, "")
    .replace(/```$/, "")
    .trim();

  return JSON.parse(cleaned);
}

export async function POST(
  req: NextRequest
) {
  try {
    const body = await req.json();

    const rawSources = Array.isArray(body.sources)
      ? body.sources
      : [];

    if (!rawSources.length) {
      return NextResponse.json(
        {
          ok: false,
          error: "분석된 원본이 없습니다.",
        },
        { status: 400 }
      );
    }

    const apiKey = process.env.OPENAI_API_KEY;

    if (!apiKey) {
      throw new Error("OPENAI_API_KEY 없음");
    }

    const model =
      process.env.OPENAI_CRM_MODEL ||
      process.env.OPENAI_JOPD_MODEL;

    if (!model) {
      throw new Error(
        "OPENAI_CRM_MODEL 또는 OPENAI_JOPD_MODEL 설정이 필요합니다."
      );
    }

    /*
     * 원본 전사 자체는 보존한다.
     * STORY ENGINE에 들어가는 분석용 텍스트만
     * 농업 용어 사전으로 정규화한다.
     */
    const sources = rawSources.map((source: any) => {
      const segments = Array.isArray(source.segments)
        ? source.segments.map((seg: any) => ({
            start: Number(seg.start || 0),
            end: Number(seg.end || 0),

            rawText: String(seg.text || ""),

            text: normalizeTranscriptText(
              String(seg.text || "")
            ),

            isQuestion: looksLikeQuestion(
              String(seg.text || "")
            ),

            lowValueClosing: isLowValueClosing(
              String(seg.text || "")
            ),
          }))
        : [];

      return {
        sourceId: source.sourceId,
        sourceName: source.sourceName,
        duration: Number(source.duration || 0),
        segments,
      };
    });

    /*
     * AI에게 맡기기 전에 질문 후보를 서버가 직접
     * 수집한다. 중요한 WHY 질문이 단순 요약 과정에서
     * 사라지는 것을 막는다.
     */
    const questionCandidates = sources.flatMap(
      (source: any) =>
        source.segments
          .filter((seg: any) => seg.isQuestion)
          .map((seg: any) => ({
            sourceId: source.sourceId,
            sourceName: source.sourceName,
            start: seg.start,
            end: seg.end,
            text: seg.text,
          }))
    );

    const system = `
당신은 JOPD 1차 가편실의 STORY PRODUCER다.

목표는 여러 촬영 원본의 실제 오디오를 읽고
"무슨 방송을 만들 것인가"를 결정하는 것이다.

이 단계에서는 실제 영상을 자르지 않는다.
방송 구성안만 만든다.

========================
절대 규칙
========================

1. SOURCE TRUTH
제공된 전사에 없는 사실, 숫자, 사람, 장소,
사건, 발언을 절대 만들지 않는다.

2. 극적 구성의 의미
사실을 과장하거나 창작하는 것이 아니다.
실제 취재 내용 중 무엇을 먼저 공개하고,
무엇을 뒤에서 설명할지를 결정하는 것이다.

3. 질문을 버리지 않는다.
PD/인터뷰어가 던진 질문은 방송의 핵심
스토리 엔진일 수 있다.

특히 다음 질문을 최우선으로 찾는다.

WHY:
왜 이것을 하는가?
왜 이 장소인가?
왜 이 작물인가?
왜 지금인가?
왜 이 방법인가?

WHAT:
무엇을 하려는가?

PROBLEM:
어떤 문제가 있는가?

RESULT:
결과가 무엇인가?

질문에 이어지는 답변까지 연결해서 판단한다.

4. 이번 자료에서
"왜 백령도에 홍산마늘을 심는가?"
또는 의미상 동일한 실제 질문이 존재한다면
절대 누락하지 않는다.

단, 실제 transcript에 있을 때만 사용한다.

5. 용어
분석용 transcript의 "홍산마늘" 표기를
정식 용어로 사용한다.

6. 단순 인사말은 이야기가 아니다.
"감사합니다"
"시청해주셔서 감사합니다"
"촬영에 협조해주셔서 감사합니다"
같은 일반적 마무리 멘트는
그 자체만으로 ENDING으로 선택하지 않는다.

실질적인 결론, 미래 계획, 감정적 여운,
핵심 메시지가 존재하면 그것을 ENDING으로
우선한다.

적절한 ENDING이 원본에 없다면
ENDING을 억지로 만들지 말고
endingStatus를 "MISSING"으로 한다.

7. 동일한 파일에서 여러 구간을 선택할 수 있다.

8. 중요한 질문과 그 답은 가능한 한
storyQuestions에 별도로 기록한다.

9. storyArc의 모든 SOURCE 구간은
실제 sourceId/sourceStart/sourceEnd를 가져야 한다.

10. transcript만으로 화면 내용을 추측하지 않는다.
화면이 필요한 경우 missingShots에 기록한다.

========================
좋은 방송 구성의 판단
========================

단순 시간순 요약이 아니다.

다음 요소를 실제 원본에서 찾는다.

- 가장 강한 HOOK
- 방송을 끌고 갈 핵심 WHY
- 주인공/핵심 인물
- 문제 또는 장애물
- 중요한 숫자와 사실
- 예상 밖의 발견
- 감정 변화
- 가장 강한 순간
- 이후 무엇이 벌어질지
- 의미 있는 마무리

질문 → 답 → 새로운 질문 → 발견
구조를 적극 활용한다.

========================
출력
========================

JSON만 출력한다.

{
  "title": "",
  "coreStory": "",
  "dramaticReason": "",

  "centralQuestion": {
    "question": "",
    "answerSummary": "",
    "sourceId": "",
    "sourceName": "",
    "sourceStart": 0,
    "sourceEnd": 0
  },

  "storyQuestions": [
    {
      "type": "WHY|WHAT|HOW|PROBLEM|RESULT|OTHER",
      "question": "",
      "answerSummary": "",
      "importance": "HIGH|MEDIUM|LOW",
      "sourceId": "",
      "sourceName": "",
      "sourceStart": 0,
      "sourceEnd": 0
    }
  ],

  "storyArc": [
    {
      "role": "HOOK|QUESTION|SETUP|PERSON|PROBLEM|DISCOVERY|INFORMATION|EMOTION|CLIMAX|BREATH|ENDING",
      "reason": "",
      "sourceId": "",
      "sourceName": "",
      "sourceStart": 0,
      "sourceEnd": 0,
      "transcript": "",
      "holdAfter": 0
    }
  ],

  "endingStatus": "FOUND|MISSING",

  "excludedLowValue": [
    {
      "sourceName": "",
      "reason": ""
    }
  ],

  "missingShots": [
    {
      "reason": "",
      "suggestion": ""
    }
  ]
}
`;

    const input = {
      sources,
      questionCandidates,
    };

    const response = await fetch(
      "https://api.openai.com/v1/responses",
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${apiKey}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          model,
          instructions: system,
          input: JSON.stringify(input),
        }),
      }
    );

    if (!response.ok) {
      throw new Error(
        `STORY ENGINE 실패: ${await response.text()}`
      );
    }

    const data = await response.json();

    const story = parseJson(
      extractOutputText(data)
    );

    const sourceMap = new Map(
      sources.map((source: any) => [
        source.sourceId,
        source,
      ])
    );

    /*
     * AI가 존재하지 않는 SOURCE 시간을
     * 만들어도 통과하지 못한다.
     */
    const validArc = (
      Array.isArray(story.storyArc)
        ? story.storyArc
        : []
    ).filter((item: any) => {
      const source = sourceMap.get(
        item.sourceId
      ) as any;

      if (!source) return false;

      const start = Number(item.sourceStart);
      const end = Number(item.sourceEnd);

      if (
        !Number.isFinite(start) ||
        !Number.isFinite(end) ||
        end <= start
      ) {
        return false;
      }

      if (
        start < 0 ||
        end > Number(source.duration) + 0.5
      ) {
        return false;
      }

      /*
       * 일반적인 감사 멘트 하나만으로
       * ENDING을 만든 경우 제거.
       */
      if (
        item.role === "ENDING" &&
        isLowValueClosing(
          String(item.transcript || "")
        )
      ) {
        return false;
      }

      item.transcript =
        normalizeTranscriptText(
          String(item.transcript || "")
        );

      return true;
    });

    /*
     * 실제 전사에서 발견된 중요한 질문을
     * 응답에도 함께 제공한다.
     * AI 구성안 검수용이다.
     */
    return NextResponse.json({
      ok: true,

      detectedQuestions:
        questionCandidates,

      story: {
        ...story,
        storyArc: validArc,
      },
    });
  } catch (error) {
    console.error(error);

    return NextResponse.json(
      {
        ok: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      },
      { status: 500 }
    );
  }
}

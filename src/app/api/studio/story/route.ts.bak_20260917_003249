    const input = {
      directorIntent,
      sources,
      questionCandidates,
      qaCandidates,
    };

    const response = await fetch(
      "https://api.openai.com/v1/responses",
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${apiKey}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          model,
          instructions: system,
          input: JSON.stringify(input),
        }),
      }
    );

    if (!response.ok) {
      throw new Error(
        `STORY ENGINE 실패: ${await response.text()}`
      );
    }

    const data = await response.json();

    const story = parseJson(
      extractOutputText(data)
    );

    const sourceMap = new Map(
      sources.map((source: any) => [
        source.sourceId,
        source,
      ])
    );

    /*
     * 가장 중요한 SOURCE TRUTH 보강.
     *
     * AI가 SOURCE transcript를 써도 믿지 않는다.
     * 실제 source/time과 겹치는 원본 전사문을
     * 서버가 다시 찾아 transcript를 덮어쓴다.
     */
    const validArc = (
      Array.isArray(story.storyArc)
        ? story.storyArc
        : []
    )
      .map((item: any) => {
        const kind = String(
          item.kind ||
            (item.sourceId ? "SOURCE" : "NARRATION")
        ).toUpperCase();

        if (kind !== "SOURCE") {
          return {
            ...item,
            kind,
            sourceId: "",
            sourceName: "",
            sourceStart: 0,
            sourceEnd: 0,
          };
        }

        const source = sourceMap.get(
          item.sourceId
        ) as any;

        if (!source) return null;

        const start = Number(item.sourceStart);
        const end = Number(item.sourceEnd);

        if (
          !Number.isFinite(start) ||
          !Number.isFinite(end) ||
          end <= start ||
          start < 0 ||
          end > Number(source.duration) + 0.5
        ) {
          return null;
        }

        const actualTranscript =
          actualTranscriptForRange(
            source,
            start,
            end
          );

        if (!actualTranscript) {
          return null;
        }

        if (
          item.role === "ENDING" &&
          isLowValueClosing(actualTranscript)
        ) {
          return null;
        }

        return {
          ...item,
          kind: "SOURCE",
          sourceName: source.sourceName,
          transcript: actualTranscript,
        };
      })
      .filter(Boolean);

    /*
     * 중앙 질문 역시 가능한 경우 실제 질문 후보로
     * 교정한다.
     */
    let centralQuestion = story.centralQuestion;

    if (
      centralQuestion &&
      centralQuestion.sourceId
    ) {
      const matched = questionCandidates.find(
        (q: any) =>
          q.sourceId === centralQuestion.sourceId &&
          Math.abs(
            Number(q.start) -
              Number(centralQuestion.sourceStart || 0)
          ) < 3
      );

      if (matched) {
        centralQuestion = {
          ...centralQuestion,
          question: matched.text,
          sourceName: matched.sourceName,
          sourceStart: matched.start,
          sourceEnd: matched.end,
        };
      }
    }

    return NextResponse.json({
      ok: true,
      detectedQuestions: questionCandidates,
      qaCandidates,

      story: {
        ...story,
        centralQuestion,
        storyArc: validArc,
        directorStory:
          story.directorStory ||
          directorIntent ||
          "",
      },
    });
  } catch (error) {
    console.error(error);

    return NextResponse.json(
      {
        ok: false,
        error:
          error instanceof Error
            ? error.message
            : String(error),
      },
      { status: 500 }
    );
  }
}

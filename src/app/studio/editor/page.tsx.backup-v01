"use client";

import {
  useMemo,
  useRef,
  useState,
  type ChangeEvent,
} from "react";

type MediaItem = {
  id: string;
  file: File;
  name: string;
  size: number;
  type: string;
  duration: number | null;
  objectUrl: string;
};

type TimelineClip = {
  id: string;
  sourceId: string;
  sourceStart: number;
  sourceEnd: number;
  timelineStart: number;
  timelineEnd: number;
  track: "V1";
  label: string;
};

function formatBytes(bytes: number) {
  if (bytes < 1024) {
    return `${bytes} B`;
  }

  if (bytes < 1024 ** 2) {
    return `${(
      bytes / 1024
    ).toFixed(1)} KB`;
  }

  if (bytes < 1024 ** 3) {
    return `${(
      bytes / 1024 ** 2
    ).toFixed(1)} MB`;
  }

  return `${(
    bytes / 1024 ** 3
  ).toFixed(2)} GB`;
}

function time(seconds: number | null) {
  if (
    seconds === null ||
    !Number.isFinite(seconds)
  ) {
    return "--:--";
  }

  const total =
    Math.max(
      0,
      Math.floor(seconds),
    );

  const h =
    Math.floor(total / 3600);

  const m =
    Math.floor(
      (total % 3600) / 60,
    );

  const s =
    total % 60;

  if (h > 0) {
    return `${String(h).padStart(
      2,
      "0",
    )}:${String(m).padStart(
      2,
      "0",
    )}:${String(s).padStart(
      2,
      "0",
    )}`;
  }

  return `${String(m).padStart(
    2,
    "0",
  )}:${String(s).padStart(
    2,
    "0",
  )}`;
}

export default function EditorPage() {
  const [media, setMedia] =
    useState<MediaItem[]>([]);

  const [selectedId, setSelectedId] =
    useState<string | null>(null);

  const [timeline, setTimeline] =
    useState<TimelineClip[]>([]);

  const [status, setStatus] =
    useState(
      "원본을 넣으면 실제 파일부터 확인합니다.",
    );

  const videoRef =
    useRef<HTMLVideoElement | null>(
      null,
    );

  const selected =
    useMemo(
      () =>
        media.find(
          (item) =>
            item.id === selectedId,
        ) || null,
      [media, selectedId],
    );

  async function inspectFile(
    file: File,
  ): Promise<MediaItem> {
    const objectUrl =
      URL.createObjectURL(file);

    const id =
      `${Date.now()}-${Math.random()
        .toString(36)
        .slice(2)}`;

    let duration: number | null =
      null;

    if (
      file.type.startsWith(
        "video/",
      ) ||
      file.type.startsWith(
        "audio/",
      )
    ) {
      duration =
        await new Promise<number | null>(
          (resolve) => {
            const element =
              document.createElement(
                file.type.startsWith(
                  "video/",
                )
                  ? "video"
                  : "audio",
              );

            element.preload =
              "metadata";

            element.onloadedmetadata =
              () => {
                resolve(
                  Number.isFinite(
                    element.duration,
                  )
                    ? element.duration
                    : null,
                );
              };

            element.onerror =
              () =>
                resolve(null);

            element.src =
              objectUrl;
          },
        );
    }

    return {
      id,
      file,
      name: file.name,
      size: file.size,
      type:
        file.type ||
        "unknown",
      duration,
      objectUrl,
    };
  }

  async function handleFiles(
    event: ChangeEvent<HTMLInputElement>,
  ) {
    const files =
      Array.from(
        event.target.files || [],
      );

    if (!files.length) {
      return;
    }

    setStatus(
      `${files.length}개 원본을 확인하고 있습니다...`,
    );

    const inspected =
      await Promise.all(
        files.map(inspectFile),
      );

    setMedia((current) => [
      ...current,
      ...inspected,
    ]);

    if (!selectedId) {
      setSelectedId(
        inspected[0].id,
      );
    }

    setStatus(
      `실제 원본 ${inspected.length}개를 등록했습니다.`,
    );

    event.target.value = "";
  }

  function removeMedia(
    id: string,
  ) {
    const target =
      media.find(
        (item) =>
          item.id === id,
      );

    if (target) {
      URL.revokeObjectURL(
        target.objectUrl,
      );
    }

    setMedia((current) =>
      current.filter(
        (item) =>
          item.id !== id,
      ),
    );

    setTimeline((current) =>
      current.filter(
        (clip) =>
          clip.sourceId !== id,
      ),
    );

    if (
      selectedId === id
    ) {
      const next =
        media.find(
          (item) =>
            item.id !== id,
        );

      setSelectedId(
        next?.id || null,
      );
    }
  }

  function addActualClip() {
    if (!selected) {
      return;
    }

    if (
      selected.duration === null
    ) {
      setStatus(
        "이 파일의 실제 길이를 확인할 수 없어 타임라인에 넣지 않았습니다.",
      );
      return;
    }

    const player =
      videoRef.current;

    const sourceStart =
      player
        ? Math.max(
            0,
            player.currentTime,
          )
        : 0;

    const remaining =
      selected.duration -
      sourceStart;

    const clipLength =
      Math.min(
        10,
        remaining,
      );

    if (clipLength <= 0) {
      setStatus(
        "선택한 위치 뒤에 사용할 영상이 없습니다.",
      );
      return;
    }

    const timelineStart =
      timeline.reduce(
        (max, clip) =>
          Math.max(
            max,
            clip.timelineEnd,
          ),
        0,
      );

    const clip: TimelineClip = {
      id:
        `${Date.now()}-${Math.random()
          .toString(36)
          .slice(2)}`,

      sourceId:
        selected.id,

      sourceStart,

      sourceEnd:
        sourceStart +
        clipLength,

      timelineStart,

      timelineEnd:
        timelineStart +
        clipLength,

      track: "V1",

      label:
        selected.name,
    };

    setTimeline(
      (current) => [
        ...current,
        clip,
      ],
    );

    setStatus(
      `실제 원본 ${time(
        sourceStart,
      )}~${time(
        sourceStart +
          clipLength,
      )} 구간을 V1에 넣었습니다.`,
    );
  }

  function removeClip(
    id: string,
  ) {
    setTimeline((current) => {
      const remaining =
        current.filter(
          (clip) =>
            clip.id !== id,
        );

      let cursor = 0;

      return remaining.map(
        (clip) => {
          const length =
            clip.sourceEnd -
            clip.sourceStart;

          const next = {
            ...clip,
            timelineStart:
              cursor,
            timelineEnd:
              cursor +
              length,
          };

          cursor += length;

          return next;
        },
      );
    });
  }

  return (
    <main
      style={{
        minHeight: "100vh",
        background: "#f4f4f1",
        color: "#171717",
        fontFamily:
          '-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo",sans-serif',
      }}
    >
      <header
        style={{
          background: "#fff",
          borderBottom:
            "1px solid #ddd",
          padding:
            "22px 30px",
        }}
      >
        <div
          style={{
            maxWidth: 1600,
            margin: "0 auto",
            display: "flex",
            justifyContent:
              "space-between",
            alignItems:
              "center",
            gap: 20,
          }}
        >
          <div>
            <div
              style={{
                color: "#777",
                fontSize: 12,
                fontWeight: 900,
              }}
            >
              JOPD AI EDITOR
            </div>

            <h1
              style={{
                margin: "5px 0 0",
              }}
            >
              조PD 편집실
            </h1>
          </div>

          <a
            href="/studio"
            style={{
              color: "#111",
              fontWeight: 800,
            }}
          >
            ← 기획실
          </a>
        </div>
      </header>

      <div
        style={{
          maxWidth: 1600,
          margin: "0 auto",
          padding: 28,
        }}
      >
        <div
          style={{
            background: "#111",
            color: "#fff",
            padding: 18,
            marginBottom: 20,
            lineHeight: 1.7,
          }}
        >
          <strong>
            SOURCE TRUTH MODE
          </strong>
          <br />
          원본에 존재하는 파일과 실제
          타임코드만 편집에 사용할 수
          있습니다. 원본에 없는 장면은
          타임라인에 생성하지 않습니다.
        </div>

        <div
          style={{
            display: "grid",
            gridTemplateColumns:
              "340px minmax(0,1fr)",
            gap: 20,
            alignItems: "start",
          }}
        >
          <section
            style={{
              background: "#fff",
              border:
                "1px solid #ddd",
              padding: 18,
            }}
          >
            <h2
              style={{
                marginTop: 0,
                fontSize: 20,
              }}
            >
              원본 미디어
            </h2>

            <label
              style={{
                display: "block",
                border:
                  "2px dashed #aaa",
                padding: 24,
                textAlign:
                  "center",
                cursor: "pointer",
                fontWeight: 900,
              }}
            >
              + 원본 영상 추가

              <input
                type="file"
                multiple
                accept="video/*,audio/*"
                onChange={
                  handleFiles
                }
                style={{
                  display: "none",
                }}
              />
            </label>

            <div
              style={{
                marginTop: 14,
              }}
            >
              {media.length ===
                0 && (
                <div
                  style={{
                    color: "#777",
                    padding:
                      "18px 0",
                  }}
                >
                  등록된 원본 없음
                </div>
              )}

              {media.map(
                (item) => (
                  <div
                    key={item.id}
                    style={{
                      borderTop:
                        "1px solid #ddd",
                      padding:
                        "13px 0",
                    }}
                  >
                    <button
                      type="button"
                      onClick={() =>
                        setSelectedId(
                          item.id,
                        )
                      }
                      style={{
                        width: "100%",
                        border: 0,
                        padding: 0,
                        background:
                          "transparent",
                        textAlign:
                          "left",
                        cursor:
                          "pointer",
                      }}
                    >
                      <strong>
                        {item.name}
                      </strong>

                      <div
                        style={{
                          color:
                            "#777",
                          fontSize:
                            13,
                          marginTop:
                            5,
                        }}
                      >
                        {formatBytes(
                          item.size,
                        )}
                        {" · "}
                        {time(
                          item.duration,
                        )}
                      </div>
                    </button>

                    <button
                      type="button"
                      onClick={() =>
                        removeMedia(
                          item.id,
                        )
                      }
                      style={{
                        marginTop:
                          8,
                        border:
                          "1px solid #bbb",
                        background:
                          "#fff",
                        padding:
                          "6px 10px",
                        cursor:
                          "pointer",
                      }}
                    >
                      삭제
                    </button>
                  </div>
                ),
              )}
            </div>
          </section>

          <section
            style={{
              minWidth: 0,
            }}
          >
            <div
              style={{
                background: "#111",
                padding: 18,
                minHeight: 420,
                display: "flex",
                alignItems:
                  "center",
                justifyContent:
                  "center",
              }}
            >
              {selected &&
              selected.type.startsWith(
                "video/",
              ) ? (
                <video
                  key={
                    selected.id
                  }
                  ref={videoRef}
                  src={
                    selected.objectUrl
                  }
                  controls
                  style={{
                    width: "100%",
                    maxHeight: 620,
                  }}
                />
              ) : (
                <div
                  style={{
                    color: "#aaa",
                    textAlign:
                      "center",
                  }}
                >
                  원본 영상을 선택하면
                  실제 화면을 여기서
                  확인합니다.
                </div>
              )}
            </div>

            {selected && (
              <div
                style={{
                  background: "#fff",
                  border:
                    "1px solid #ddd",
                  padding: 18,
                  display: "flex",
                  justifyContent:
                    "space-between",
                  alignItems:
                    "center",
                  gap: 16,
                  flexWrap: "wrap",
                }}
              >
                <div>
                  <strong>
                    {selected.name}
                  </strong>

                  <div
                    style={{
                      color: "#777",
                      marginTop: 5,
                    }}
                  >
                    실제 길이{" "}
                    {time(
                      selected.duration,
                    )}
                  </div>
                </div>

                <button
                  type="button"
                  onClick={
                    addActualClip
                  }
                  style={{
                    border: 0,
                    background:
                      "#111",
                    color: "#fff",
                    padding:
                      "13px 18px",
                    fontWeight: 900,
                    cursor:
                      "pointer",
                  }}
                >
                  현재 위치부터
                  10초 V1에 넣기
                </button>
              </div>
            )}
          </section>
        </div>

        <div
          style={{
            marginTop: 20,
            background: "#fff",
            border:
              "1px solid #ddd",
          }}
        >
          <div
            style={{
              padding:
                "15px 18px",
              borderBottom:
                "1px solid #ddd",
              display: "flex",
              justifyContent:
                "space-between",
              gap: 20,
            }}
          >
            <strong>
              실제 편집 타임라인
            </strong>

            <span
              style={{
                color: "#666",
              }}
            >
              {timeline.length} clips
            </span>
          </div>

          <div
            style={{
              padding: 18,
              overflowX: "auto",
            }}
          >
            <div
              style={{
                minWidth: 900,
              }}
            >
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "70px 1fr",
                  borderBottom:
                    "1px solid #ddd",
                  paddingBottom:
                    10,
                }}
              >
                <strong>
                  TRACK
                </strong>

                <div>
                  00:00
                  &nbsp;&nbsp;&nbsp;&nbsp;
                  00:30
                  &nbsp;&nbsp;&nbsp;&nbsp;
                  01:00
                  &nbsp;&nbsp;&nbsp;&nbsp;
                  01:30
                </div>
              </div>

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns:
                    "70px 1fr",
                  minHeight: 100,
                  padding:
                    "12px 0",
                }}
              >
                <strong>
                  V1
                </strong>

                <div
                  style={{
                    display: "flex",
                    gap: 3,
                    alignItems:
                      "stretch",
                  }}
                >
                  {timeline.length ===
                    0 && (
                    <div
                      style={{
                        color:
                          "#888",
                        padding:
                          20,
                      }}
                    >
                      아직 타임라인에
                      실제 클립이
                      없습니다.
                    </div>
                  )}

                  {timeline.map(
                    (clip) => (
                      <div
                        key={
                          clip.id
                        }
                        style={{
                          minWidth:
                            Math.max(
                              130,
                              (clip.timelineEnd -
                                clip.timelineStart) *
                                10,
                            ),
                          background:
                            "#e5e5e5",
                          border:
                            "1px solid #aaa",
                          padding:
                            10,
                        }}
                      >
                        <strong>
                          {
                            clip.label
                          }
                        </strong>

                        <div
                          style={{
                            marginTop:
                              6,
                            fontSize:
                              12,
                          }}
                        >
                          SOURCE{" "}
                          {time(
                            clip.sourceStart,
                          )}
                          {" → "}
                          {time(
                            clip.sourceEnd,
                          )}
                        </div>

                        <div
                          style={{
                            marginTop:
                              4,
                            fontSize:
                              12,
                            color:
                              "#666",
                          }}
                        >
                          TL{" "}
                          {time(
                            clip.timelineStart,
                          )}
                          {" → "}
                          {time(
                            clip.timelineEnd,
                          )}
                        </div>

                        <button
                          type="button"
                          onClick={() =>
                            removeClip(
                              clip.id,
                            )
                          }
                          style={{
                            marginTop:
                              8,
                            border:
                              "1px solid #aaa",
                            background:
                              "#fff",
                            cursor:
                              "pointer",
                          }}
                        >
                          클립 삭제
                        </button>
                      </div>
                    ),
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div
          style={{
            marginTop: 14,
            padding: 15,
            background: "#eee",
            fontWeight: 700,
          }}
        >
          {status}
        </div>

        <section
          style={{
            marginTop: 20,
            background: "#fff",
            border:
              "1px solid #ddd",
            padding: 20,
          }}
        >
          <h2
            style={{
              marginTop: 0,
            }}
          >
            다음 자동화 단계
          </h2>

          <p
            style={{
              lineHeight: 1.8,
              marginBottom: 0,
            }}
          >
            MEDIA ENGINE이 원본에서
            오디오와 분석용 프록시를
            생성하고 전체 발언을
            전사합니다. 그 결과에서
            실제 숫자·인물·발언과
            실제 원본 타임코드를
            확인한 뒤 AUTO EDIT
            ENGINE이 V1/A1/SUB
            타임라인을 자동으로
            구성합니다.
          </p>
        </section>
      </div>
    </main>
  );
}

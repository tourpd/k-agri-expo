"use client";

import {
  useMemo,
  useRef,
  useState,
  type ChangeEvent,
} from "react";

type TranscriptSegment = {
  start: number;
  end: number;
  text: string;
};

type Analysis = {
  status:
    | "waiting"
    | "uploading"
    | "transcribing"
    | "done"
    | "error";
  progress: number;
  uploadId?: string;
  text?: string;
  segments?: TranscriptSegment[];
  topic?: string;
  summary?: string;
  error?: string;
};

type SourceItem = {
  id: string;
  file: File;
  name: string;
  size: number;
  duration: number;
  objectUrl: string;
  analysis: Analysis;
};

type StoryItem = {
  kind?: string;
  role: string;
  reason: string;
  sourceId: string;
  sourceName: string;
  sourceStart: number;
  sourceEnd: number;
  transcript: string;
  narration?: string;
  visualInstruction?: string;
  searchQuery?: string;
  rightsStatus?: string;
  disclosure?: string;
  holdAfter?: number;
};

type StoryResult = {
  title?: string;
  sourceDiscoveredStory?: string;
  directorStory?: string;
  coreStory?: string;
  dramaticReason?: string;
  climaxStatus?: string;
  endingStatus?: string;
  storyArc?: StoryItem[];
  emotionalArc?: Array<{
    stage: string;
    emotion: string;
    reason: string;
  }>;
  excludedSources?: Array<{
    sourceName: string;
    reason: string;
  }>;
  missingShots?: Array<{
    reason: string;
    suggestion: string;
  }>;
};

function uid() {
  return (
    Date.now().toString(36) +
    Math.random().toString(36).slice(2)
  );
}

function formatBytes(bytes: number) {
  if (bytes < 1024 ** 2)
    return `${(bytes / 1024).toFixed(1)} KB`;

  if (bytes < 1024 ** 3)
    return `${(bytes / 1024 ** 2).toFixed(1)} MB`;

  return `${(bytes / 1024 ** 3).toFixed(2)} GB`;
}

function formatTime(sec: number) {
  if (!Number.isFinite(sec)) return "--:--";

  const s = Math.max(0, sec);
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const ss = Math.floor(s % 60);

  if (h > 0) {
    return `${String(h).padStart(2, "0")}:${String(
      m
    ).padStart(2, "0")}:${String(ss).padStart(2, "0")}`;
  }

  return `${String(m).padStart(2, "0")}:${String(ss).padStart(
    2,
    "0"
  )}`;
}

function getDuration(file: File, url: string): Promise<number> {
  return new Promise((resolve) => {
    const video = document.createElement("video");
    video.preload = "metadata";

    video.onloadedmetadata = () => {
      resolve(Number.isFinite(video.duration) ? video.duration : 0);
    };

    video.onerror = () => resolve(0);
    video.src = url;
  });
}

function deriveTopic(text: string) {
  const cleaned = text.replace(/\s+/g, " ").trim();

  if (!cleaned) return "음성 내용 없음";

  const first = cleaned
    .split(/[.!?。]/)
    .map((x) => x.trim())
    .find(Boolean);

  if (!first) return cleaned.slice(0, 70);

  return first.length > 70
    ? first.slice(0, 70) + "…"
    : first;
}

function deriveSummary(text: string) {
  const cleaned = text.replace(/\s+/g, " ").trim();

  if (!cleaned) return "전사된 음성이 없습니다.";

  return cleaned.length > 220
    ? cleaned.slice(0, 220) + "…"
    : cleaned;
}

export default function RoughCutPage() {
  const [sources, setSources] = useState<SourceItem[]>([]);
  const [selectedId, setSelectedId] = useState<string | null>(null);

  const [story, setStory] = useState<StoryResult | null>(null);

  const [directorIntent, setDirectorIntent] = useState("");

  const [storyStatus, setStoryStatus] = useState<
    "idle" | "waiting" | "running" | "done" | "error"
  >("idle");

  const [storyError, setStoryError] = useState("");

  const [openTranscripts, setOpenTranscripts] =
    useState<Record<string, boolean>>({});

  const runningRef = useRef<Set<string>>(new Set());

  const selected = useMemo(
    () => sources.find((s) => s.id === selectedId) || null,
    [sources, selectedId]
  );

  const doneCount = sources.filter(
    (s) => s.analysis.status === "done"
  ).length;

  const processingCount = sources.filter((s) =>
    ["uploading", "transcribing"].includes(s.analysis.status)
  ).length;

  const totalDuration = sources.reduce(
    (sum, s) => sum + (s.duration || 0),
    0
  );

  function patchSource(
    id: string,
    patch: Partial<SourceItem> | {
      analysis: Partial<Analysis>;
    }
  ) {
    setSources((current) =>
      current.map((item) => {
        if (item.id !== id) return item;

        if ("analysis" in patch) {
          return {
            ...item,
            analysis: {
              ...item.analysis,
              ...patch.analysis,
            },
          };
        }

        return {
          ...item,
          ...patch,
        };
      })
    );
  }

  async function uploadAndTranscribe(source: SourceItem) {
    if (runningRef.current.has(source.id)) return;

    runningRef.current.add(source.id);

    try {
      const uploadId = `${Date.now()}_${source.id}`.replace(
        /[^a-zA-Z0-9_-]/g,
        ""
      );

      const CHUNK_SIZE = 8 * 1024 * 1024;

      const totalChunks = Math.ceil(
        source.file.size / CHUNK_SIZE
      );

      patchSource(source.id, {
        analysis: {
          status: "uploading",
          progress: 0,
          uploadId,
        },
      });

      for (let i = 0; i < totalChunks; i++) {
        const start = i * CHUNK_SIZE;
        const end = Math.min(
          source.file.size,
          start + CHUNK_SIZE
        );

        const blob = source.file.slice(start, end);

        const response = await fetch(
          "/api/studio/media?action=chunk",
          {
            method: "POST",
            headers: {
              "x-upload-id": uploadId,
              "x-file-name": source.name,
              "x-chunk-index": String(i),
              "x-total-chunks": String(totalChunks),
            },
            body: blob,
          }
        );

        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(
            result.error || `업로드 실패 ${i + 1}/${totalChunks}`
          );
        }

        patchSource(source.id, {
          analysis: {
            status: "uploading",
            progress: Math.round(
              ((i + 1) / totalChunks) * 70
            ),
            uploadId,
          },
        });
      }

      const completeResponse = await fetch(
        "/api/studio/media?action=complete",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ uploadId }),
        }
      );

      const complete = await completeResponse.json();

      if (!completeResponse.ok || !complete.ok) {
        throw new Error(
          complete.error || "원본 결합 실패"
        );
      }

      patchSource(source.id, {
        analysis: {
          status: "transcribing",
          progress: 78,
          uploadId,
        },
      });

      const transcribeResponse = await fetch(
        "/api/studio/media?action=transcribe",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ uploadId }),
        }
      );

      const transcript = await transcribeResponse.json();

      if (!transcribeResponse.ok || !transcript.ok) {
        throw new Error(
          transcript.error || "음성 전사 실패"
        );
      }

      const text = String(transcript.text || "");

      patchSource(source.id, {
        analysis: {
          status: "done",
          progress: 100,
          uploadId,
          text,
          segments: Array.isArray(transcript.segments)
            ? transcript.segments
            : [],
          topic: deriveTopic(text),
          summary: deriveSummary(text),
        },
      });
    } catch (error) {
      patchSource(source.id, {
        analysis: {
          status: "error",
          progress: 0,
          error:
            error instanceof Error
              ? error.message
              : String(error),
        },
      });
    } finally {
      runningRef.current.delete(source.id);
    }
  }

  async function handleFiles(
    event: ChangeEvent<HTMLInputElement>
  ) {
    const files = Array.from(event.target.files || []);

    if (!files.length) return;

    const created: SourceItem[] = [];

    for (const file of files) {
      const objectUrl = URL.createObjectURL(file);
      const duration = await getDuration(file, objectUrl);

      created.push({
        id: uid(),
        file,
        name: file.name,
        size: file.size,
        duration,
        objectUrl,
        analysis: {
          status: "waiting",
          progress: 0,
        },
      });
    }

    setSources((current) => [...current, ...created]);

    if (!selectedId && created[0]) {
      setSelectedId(created[0].id);
    }

    setStory(null);
    setStoryStatus("waiting");

    event.target.value = "";

    /*
     * 파일을 넣는 순간 자동 분석.
     * 별도의 '분석 시작' 버튼은 없다.
     */
    for (const source of created) {
      uploadAndTranscribe(source);
    }
  }

  function removeSource(id: string) {
    setSources((current) => {
      const target = current.find((x) => x.id === id);

      if (target) {
        URL.revokeObjectURL(target.objectUrl);
      }

      return current.filter((x) => x.id !== id);
    });

    if (selectedId === id) {
      setSelectedId(null);
    }

    setStory(null);
    setStoryStatus("waiting");
  }

  async function buildStory() {
    const completed = sources.filter(
      (s) => s.analysis.status === "done"
    );

    if (!completed.length) return;

    if (completed.length !== sources.length) {
      setStoryError(
        "모든 원본의 오디오 분석이 끝난 뒤 전체 구성안을 만듭니다."
      );
      return;
    }

    setStoryStatus("running");
    setStoryError("");

    try {
      const response = await fetch("/api/studio/story", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          directorIntent,
          sources: completed.map((s) => ({
            sourceId: s.id,
            sourceName: s.name,
            duration: s.duration,
            text: s.analysis.text || "",
            segments: s.analysis.segments || [],
          })),
        }),
      });

      const result = await response.json();

      if (!response.ok || !result.ok) {
        throw new Error(
          result.error || "전체 방송 구성안 생성 실패"
        );
      }

      setStory(result.story);
      setStoryStatus("done");
    } catch (error) {
      setStoryStatus("error");
      setStoryError(
        error instanceof Error
          ? error.message
          : String(error)
      );
    }
  }

  /*
   * 모든 파일의 전사가 끝나면 사용자가
   * 별도 버튼을 찾지 않아도 자동으로
   * 전체 STORY 분석을 시작한다.
   */
  const allDone =
    sources.length > 0 &&
    doneCount === sources.length;

  const autoStoryStartedRef = useRef(false);

  if (
    allDone &&
    storyStatus === "waiting" &&
    !autoStoryStartedRef.current
  ) {
    autoStoryStartedRef.current = true;

    setTimeout(() => {
      buildStory();
    }, 0);
  }

  if (
    !allDone &&
    autoStoryStartedRef.current
  ) {
    autoStoryStartedRef.current = false;
  }

  return (
    <main className="page">
      <header className="topbar">
        <div>
          <div className="eyebrow">JOPD AI · 1차 가편실</div>
          <h1>원본 분석 · 방송 구성</h1>
        </div>

        <div className="topActions">
          <a href="/studio">← 기획실</a>
          <span>
            {doneCount}/{sources.length} 분석
          </span>
        </div>
      </header>

      <div className="truth">
        <strong>SOURCE TRUTH MODE</strong>
        <span>
          원본의 실제 오디오와 실제 타임코드만
          분석합니다. 1차 가편실에서는 영상을
          자르지 않습니다.
        </span>
      </div>

      <section className="workspace">
        <aside className="library">
          <div className="libraryHead">
            <div>
              <strong>원본 영상</strong>
              <div className="muted">
                {sources.length}개 · {formatTime(totalDuration)}
              </div>
            </div>

            <label className="uploadButton">
              + 영상 추가
              <input
                type="file"
                multiple
                accept="video/*,audio/*"
                onChange={handleFiles}
                hidden
              />
            </label>
          </div>

          <div className="mediaList">
            {sources.length === 0 && (
              <div className="empty">
                원본 영상을 넣으면 각 영상의 오디오
                분석이 자동으로 시작됩니다.
              </div>
            )}

            {sources.map((source) => (
              <button
                key={source.id}
                type="button"
                className={
                  "mediaRow " +
                  (selectedId === source.id
                    ? "selected"
                    : "")
                }
                onClick={() => setSelectedId(source.id)}
              >
                <div className="thumb">
                  <video
                    src={source.objectUrl}
                    preload="metadata"
                    muted
                  />
                  <span>{formatTime(source.duration)}</span>
                </div>

                <div className="mediaInfo">
                  <div className="fileName">{source.name}</div>

                  <div className="fileMeta">
                    {formatBytes(source.size)}
                  </div>

                  {source.analysis.status === "waiting" && (
                    <div className="status waiting">
                      분석 대기
                    </div>
                  )}

                  {source.analysis.status === "uploading" && (
                    <>
                      <div className="status working">
                        원본 준비중 {source.analysis.progress}%
                      </div>
                      <div className="progress">
                        <i
                          style={{
                            width: `${source.analysis.progress}%`,
                          }}
                        />
                      </div>
                    </>
                  )}

                  {source.analysis.status ===
                    "transcribing" && (
                    <div className="status working">
                      ● 오디오 읽는 중…
                    </div>
                  )}

                  {source.analysis.status === "done" && (
                    <>
                      <div className="status done">
                        ● 오디오 분석완료
                      </div>

                      <div className="topic">
                        <b>주제</b>
                        {source.analysis.topic}
                      </div>

                      <div className="summary">
                        {source.analysis.summary}
                      </div>
                    </>
                  )}

                  {source.analysis.status === "error" && (
                    <div className="status error">
                      분석 오류 · {source.analysis.error}
                    </div>
                  )}

                  <span
                    className="remove"
                    onClick={(e) => {
                      e.stopPropagation();
                      removeSource(source.id);
                    }}
                  >
                    삭제
                  </span>
                </div>
              </button>
            ))}
          </div>
        </aside>

        <section className="viewer">
          {selected ? (
            <>
              <div className="player">
                {selected.file.type.startsWith("video/") ? (
                  <video
                    key={selected.id}
                    src={selected.objectUrl}
                    controls
                  />
                ) : (
                  <audio
                    key={selected.id}
                    src={selected.objectUrl}
                    controls
                  />
                )}
              </div>

              <div className="sourceTitle">
                <div>
                  <h2>{selected.name}</h2>
                  <span>
                    {formatTime(selected.duration)} ·{" "}
                    {formatBytes(selected.size)}
                  </span>
                </div>

                <div
                  className={`bigStatus ${selected.analysis.status}`}
                >
                  {selected.analysis.status === "done"
                    ? "오디오 분석 완료"
                    : selected.analysis.status === "transcribing"
                    ? "오디오 분석 중"
                    : selected.analysis.status === "uploading"
                    ? `원본 준비 ${selected.analysis.progress}%`
                    : selected.analysis.status === "error"
                    ? "분석 오류"
                    : "분석 대기"}
                </div>
              </div>

              <div className="analysisPanel">
                <div className="analysisSummary">
                  <div>
                    <span className="label">이 영상의 주제</span>
                    <h3>
                      {selected.analysis.topic ||
                        "오디오 분석 후 자동 표시됩니다."}
                    </h3>
                  </div>

                  <div>
                    <span className="label">내용</span>
                    <p>
                      {selected.analysis.summary ||
                        "영상이 등록되면 오디오 전체를 읽고 실제 내용을 정리합니다."}
                    </p>
                  </div>
                </div>

                <div className="transcript">
                  <div className="transcriptHead">
                    <strong>실제 오디오 · 타임코드</strong>

                    <div className="transcriptControls">
                      <span>
                        {selected.analysis.segments?.length || 0}개 구간
                      </span>

                      {!!selected.analysis.segments?.length && (
                        <button
                          type="button"
                          className="transcriptToggle"
                          onClick={() =>
                            setOpenTranscripts((current) => ({
                              ...current,
                              [selected.id]:
                                !current[selected.id],
                            }))
                          }
                        >
                          {openTranscripts[selected.id]
                            ? "전체 오디오 닫기 ▲"
                            : `전체 오디오 ${
                                selected.analysis.segments?.length || 0
                              }개 보기 ▼`}
                        </button>
                      )}
                    </div>
                  </div>

                  {selected.analysis.status !== "done" && (
                    <div className="transcriptEmpty">
                      {selected.analysis.status === "error"
                        ? selected.analysis.error
                        : "오디오 분석이 끝나면 실제 발언이 여기에 나타납니다."}
                    </div>
                  )}

                  {(openTranscripts[selected.id]
                    ? selected.analysis.segments
                    : selected.analysis.segments?.slice(0, 8)
                  )?.map(
                    (segment, index) => (
                      <button
                        type="button"
                        className="transcriptRow"
                        key={`${segment.start}-${index}`}
                        onClick={() => {
                          const player =
                            document.querySelector<HTMLVideoElement>(
                              ".player video"
                            );

                          if (player) {
                            player.currentTime = segment.start;
                            player.play().catch(() => {});
                          }
                        }}
                      >
                        <span className="time">
                          {formatTime(segment.start)}
                        </span>
                        <span>{segment.text}</span>
                      </button>
                    )
                  )}

                  {!openTranscripts[selected.id] &&
                    (selected.analysis.segments?.length || 0) > 8 && (
                      <button
                        type="button"
                        className="showMoreTranscript"
                        onClick={() =>
                          setOpenTranscripts((current) => ({
                            ...current,
                            [selected.id]: true,
                          }))
                        }
                      >
                        나머지 {Math.max(
                          0,
                          (selected.analysis.segments?.length || 0) - 8
                        )}개 오디오 더 보기 ↓
                      </button>
                    )}
                </div>
              </div>
            </>
          ) : (
            <div className="noSelection">
              <strong>1차 가편실</strong>
              <p>
                왼쪽에서 영상을 추가하십시오. 파일마다
                오디오 분석이 자동으로 시작됩니다.
              </p>
            </div>
          )}
        </section>
      </section>

      <section className="storySection">
        <div className="storyHeader">
          <div>
            <div className="eyebrow">전체 원본 통합 분석</div>
            <h2>AI 방송 구성안</h2>
            <p>
              개별 영상 분석이 모두 끝나면 촬영 순서에
              얽매이지 않고 실제 원본 내용으로 방송의
              이야기 순서를 구성합니다.
            </p>
          </div>

          <div className="storyProgress">
            {sources.length === 0 && "원본을 추가하세요"}

            {sources.length > 0 &&
              !allDone &&
              `원본 분석 ${doneCount}/${sources.length}`}

            {storyStatus === "running" && "전체 이야기 구성 중…"}

            {storyStatus === "done" && "구성 완료"}
          </div>
        </div>

        <div className="directorIntent">
          <div className="directorIntentHead">
            <div>
              <span className="label">PD DIRECTOR&apos;S INTENT</span>
              <strong>PD가 만들고 싶은 이야기</strong>
              <p>
                원본에 무엇이 있는지는 AI가 찾고,
                이 취재로 무엇을 말할지는 PD가 정합니다.
                아직 정하지 않았다면 비워두어도 됩니다.
              </p>
            </div>

            <button
              type="button"
              disabled={!allDone || storyStatus === "running"}
              onClick={() => {
                autoStoryStartedRef.current = true;
                buildStory();
              }}
            >
              {storyStatus === "running"
                ? "다시 구성 중…"
                : "이 주제로 방송 다시 구성"}
            </button>
          </div>

          <textarea
            value={directorIntent}
            onChange={(e) => setDirectorIntent(e.target.value)}
            placeholder={`예)
이번 방송에서 시청자에게 무엇을 말하고 싶은지 적으십시오.

AI는 이 의도를 기준으로 실제 원본을 다시 찾고,
없는 연결은 내레이션,
없는 위치 화면은 LOCATION ZOOM,
필요한 자료화면은 외부영상/아카이브,
마지막 수단으로 AI 영상을 제안합니다.`}
          />
        </div>

        {processingCount > 0 && (
          <div className="storyWaiting">
            현재 {processingCount}개 원본을 읽고 있습니다.
            모든 영상의 실제 오디오를 확인한 뒤 전체
            구성안을 만듭니다.
          </div>
        )}

        {storyError && (
          <div className="storyError">{storyError}</div>
        )}

        {story && (
          <>
            <div className="storyCore">
              <div>
                <span className="label">제목 방향</span>
                <h3>{story.title || "-"}</h3>
              </div>

              <div>
                <span className="label">

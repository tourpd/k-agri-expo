function ExcelTable({ headers, rows }: { headers: string[]; rows: string[][] }) {
  return (
    <div style={S.tableWrap}>
      <table style={S.table}>
        <thead>
          <tr>{headers.map((h) => <th key={h} style={S.th}>{h}</th>)}</tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr key={i}>
              {r.map((c, j) => (
                <td key={j} style={S.td}>
                  {c.startsWith("/") ? <Link href={c} style={S.openBtn}>이동</Link> : c}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

function SimpleData({ rows, empty }: { rows: any[]; empty: string }) {
  if (!rows.length) return <div style={S.empty}>{empty}</div>;

  return (
    <div style={S.tableWrap}>
      <table style={S.table}>
        <thead>
          <tr>
            {Object.keys(rows[0]).slice(0, 6).map((h) => <th key={h} style={S.th}>{h}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr key={r.id ?? i}>
              {Object.keys(r).slice(0, 6).map((k) => (
                <td key={k} style={S.td}>{String(r[k] ?? "-").slice(0, 80)}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

function Mini({ title, value }: { title: string; value: string }) {
  return (
    <div style={S.mini}>
      <div style={S.miniTitle}>{title}</div>
      <div style={S.miniValue}>{value}</div>
    </div>
  );
}


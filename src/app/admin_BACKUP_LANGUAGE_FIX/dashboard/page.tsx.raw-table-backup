}


function ActionBox({
  title,
  desc,
  actions,
}: {
  title: string;
  desc: string;
  actions: string[][];
}) {
  return (
    <div style={S.actionBox}>
      <h3 style={S.actionTitle}>{title}</h3>
      <p style={S.actionDesc}>{desc}</p>
      <div style={S.actionBtns}>
        {actions.map(([label, href]) => (
          <Link key={href} href={href} style={S.actionBtn}>
            {label} →
          </Link>
        ))}
      </div>
    </div>
  );
}

function Data({ rows, empty }: { rows: any[]; empty: string }) {
  if (!rows.length) return <div style={S.empty}>{empty}</div>;
  const keys = Object.keys(rows[0]).slice(0, 6);
  return (
    <div style={S.tableWrap}>
      <table style={S.table}>
        <thead>
          <tr>{keys.map((k) => <th key={k} style={S.th}>{k}</th>)}</tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr key={r.id ?? i}>
              {keys.map((k) => <td key={k} style={S.td}>{String(r[k] ?? "-").slice(0, 70)}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

